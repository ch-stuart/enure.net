---
import Grid from "../components/Grid.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>→ → → enure.net → → →</title>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content="Ceci n'est un site web personnel." />
    <link rel="icon" href="/favicon.ico" />
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="dd80ea2d-3191-4286-93cf-77a0f7f2f61a"></script>
    <!-- LTeX: enabled=false -->
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      :root {
        --cell-w: min(60vw, 330px);
        --cell-h: 60svh;
      }
      body {
        background-color: white;
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          Oxygen,
          Ubuntu,
          Cantarell,
          "Open Sans",
          "Helvetica Neue",
          sans-serif;
      }
      @media (pointer: coarse) {
        html {
          scroll-snap-type: both proximity;
          scroll-padding: 10px;
        }
      }
    </style>
    <!-- LTeX: enabled=true -->
  </head>
  <body>
    <Grid />
  </body>
</html>
